# Nextellar — Environment Variables
# Copy this file to .env.local and fill in your values

# Stellar Network Configuration
NEXT_PUBLIC_HORIZON_URL={{HORIZON_URL}}
NEXT_PUBLIC_SOROBAN_URL={{SOROBAN_URL}}
NEXT_PUBLIC_NETWORK={{NETWORK}}

# Wallet Configuration (comma-separated: freighter,albedo,lobstr,xbull,hana,ledger,walletconnect)
# NEXT_PUBLIC_WALLETS=freighter,albedo,lobstr

# WalletConnect (only used when "walletconnect" is in the wallet list)
# Project ID from https://cloud.reown.com (32 hex characters)
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# NEXT_PUBLIC_WALLETCONNECT_APP_URL=https://your-dapp.example
# NEXT_PUBLIC_WALLETCONNECT_ICON=https://your-dapp.example/icon.png

# Soroban Contract IDs (add after deploying contracts)
# NEXT_PUBLIC_CONTRACT_ID=

# App Metadata
NEXT_PUBLIC_APP_NAME={{APP_NAME}}