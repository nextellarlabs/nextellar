{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextellar.dev/schemas/config.v1.json",
  "title": "Nextellar project config",
  "type": "object",
  "required": ["schemaVersion", "nextellarVersion", "template", "createdAt"],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Version of this config schema."
    },
    "nextellarVersion": { "type": "string" },
    "template": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "horizonUrl": { "type": "string", "format": "uri" },
    "sorobanUrl": { "type": "string", "format": "uri" },
    "wallets": { "type": "array", "items": { "type": "string" } },
    "contracts": {
      "type": "array",
      "description": "Soroban contracts registered in this project.",
      "items": {
        "type": "object",
        "required": ["name", "path", "bindings", "hook", "docs"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "bindings": { "type": "string" },
          "hook": { "type": "string" },
          "docs": { "type": "string" },
          "template": { "type": "string" },
          "addedAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
